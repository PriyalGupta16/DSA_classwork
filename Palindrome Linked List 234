class Solution {
    public boolean isPalindrome(ListNode head) {
        ArrayList<Integer> a = new ArrayList<>();

        while (head != null) {
            a.add(head.val);
            head = head.next;
        }

        int l = 0, r = a.size() - 1;

        while (l < r) {
            if (!a.get(l).equals(a.get(r))) return false;
            l++;
            r--;
        }

        return true;
    }
}